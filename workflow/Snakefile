import pandas as pd

configfile: "config/config.yaml"

samples = pd.read_csv(config["samples"], sep="\t").set_index("sample", drop=False)
SAMPLES = list(samples.index)
FQ = config["fastq_dir"]
OUT = config["outdir"]

rule all:
    input:
        expand(OUT + "/fastqc_raw/{sample}_R{r}_fastqc.html", sample=SAMPLES, r=[1, 2]),
        expand(OUT + "/trimmed/{sample}_R{r}.fastq.gz", sample=SAMPLES, r=[1, 2]),
        expand(OUT + "/fastqc_trimmed/{sample}_R{r}_fastqc.html", sample=SAMPLES, r=[1, 2]),
        expand(OUT + "/hisat2/{sample}.sorted.bam.bai", sample=SAMPLES),
        OUT + "/featurecounts/counts.txt",
        expand(OUT + "/kallisto/{sample}/abundance.tsv", sample=SAMPLES),
        OUT + "/multiqc/multiqc_report.html",
        OUT + "/deeptools/correlation_heatmap.png",
        OUT + "/deeptools/pca.png",

rule fastqc_raw:
    input:
        FQ + "/{sample}_R{r}.fastq.gz"
    output:
        html=OUT + "/fastqc_raw/{sample}_R{r}_fastqc.html",
        zip=OUT + "/fastqc_raw/{sample}_R{r}_fastqc.zip"
    params:
        outdir=OUT + "/fastqc_raw"
    threads: 2
    resources:
        mem_mb=2000,
        runtime=60
    conda:
        "envs/qc.yaml"
    log:
        "logs/fastqc_raw/{sample}_R{r}.log"
    shell:
        "fastqc -t {threads} -o {params.outdir} {input} &> {log}"

rule fastp:
    input:
        r1=FQ + "/{sample}_R1.fastq.gz",
        r2=FQ + "/{sample}_R2.fastq.gz"
    output:
        r1=OUT + "/trimmed/{sample}_R1.fastq.gz",
        r2=OUT + "/trimmed/{sample}_R2.fastq.gz",
        json=OUT + "/fastp/{sample}.json",
        html=OUT + "/fastp/{sample}.html"
    threads: config["threads"]["fastp"]
    resources:
        mem_mb=4000,
        runtime=120
    conda:
        "envs/fastp.yaml"
    log:
        "logs/fastp/{sample}.log"
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "-j {output.json} -h {output.html} -w {threads} &> {log}"
rule fastqc_trimmed:
    input:
        OUT + "/trimmed/{sample}_R{r}.fastq.gz"
    output:
        html=OUT + "/fastqc_trimmed/{sample}_R{r}_fastqc.html",
        zip=OUT + "/fastqc_trimmed/{sample}_R{r}_fastqc.zip"
    params:
        outdir=OUT + "/fastqc_trimmed"
    threads: 2
    resources:
        mem_mb=2000,
        runtime=60
    conda:
        "envs/qc.yaml"
    log:
        "logs/fastqc_trimmed/{sample}_R{r}.log"
    shell:
        "fastqc -t {threads} -o {params.outdir} {input} &> {log}"

rule hisat2_index:
    input:
        config["reference"]["genome"]
    output:
        directory(OUT + "/index/hisat2")
    params:
        prefix=OUT + "/index/hisat2/genome"
    threads: config["threads"]["hisat2"]
    resources:
        mem_mb=32000,
        runtime=240
    conda:
        "envs/hisat2.yaml"
    log:
        "logs/hisat2_index.log"
    shell:
        "mkdir -p {output} && hisat2-build -p {threads} {input} {params.prefix} &> {log}"

rule hisat2_align:
    input:
        r1=OUT + "/trimmed/{sample}_R1.fastq.gz",
        r2=OUT + "/trimmed/{sample}_R2.fastq.gz",
        index=OUT + "/index/hisat2"
    output:
        bam=OUT + "/hisat2/{sample}.sorted.bam",
        bai=OUT + "/hisat2/{sample}.sorted.bam.bai"
    params:
        prefix=OUT + "/index/hisat2/genome"
    threads: config["threads"]["hisat2"]
    resources:
        mem_mb=16000,
        runtime=240
    conda:
        "envs/hisat2.yaml"
    log:
        "logs/hisat2/{sample}.log"
    shell:
        "(hisat2 -p {threads} -x {params.prefix} -1 {input.r1} -2 {input.r2} "
        "| samtools sort -@ 2 -o {output.bam} - && samtools index {output.bam}) &> {log}"

rule featurecounts:
    input:
        bams=expand(OUT + "/hisat2/{sample}.sorted.bam", sample=SAMPLES),
        gtf=config["reference"]["gtf"]
    output:
        counts=OUT + "/featurecounts/counts.txt",
        summary=OUT + "/featurecounts/counts.txt.summary"
    params:
        strand=config.get("strandedness", 0)
    threads: config["threads"]["featurecounts"]
    resources:
        mem_mb=8000,
        runtime=120
    conda:
        "envs/subread.yaml"
    log:
        "logs/featurecounts.log"
    shell:
        "featureCounts -T {threads} -p --countReadPairs -B -C -s {params.strand} "
        "-a {input.gtf} -o {output.counts} {input.bams} &> {log}"

rule kallisto_index:
    input:
        config["reference"]["transcripts"]
    output:
        OUT + "/index/kallisto/transcripts.idx"
    resources:
        mem_mb=48000,
        runtime=240
    conda:
        "envs/kallisto.yaml"
    log:
        "logs/kallisto_index.log"
    shell:
        "kallisto index -i {output} {input} &> {log}"

rule kallisto_quant:
    input:
        r1=OUT + "/trimmed/{sample}_R1.fastq.gz",
        r2=OUT + "/trimmed/{sample}_R2.fastq.gz",
        index=OUT + "/index/kallisto/transcripts.idx"
    output:
        OUT + "/kallisto/{sample}/abundance.tsv",
        OUT + "/kallisto/{sample}/abundance.h5",
        OUT + "/kallisto/{sample}/run_info.json"
    params:
        outdir=OUT + "/kallisto/{sample}"
    threads: config["threads"]["kallisto"]
    resources:
        mem_mb=8000,
        runtime=120
    conda:
        "envs/kallisto.yaml"
    log:
        "logs/kallisto/{sample}.log"
    shell:
        "kallisto quant -i {input.index} -o {params.outdir} -t {threads} "
        "{input.r1} {input.r2} &> {log}"

rule gtf_to_bed:
    input:
        config["reference"]["gtf"]
    output:
        OUT + "/reference/genes.bed12"
    resources:
        mem_mb=8000,
        runtime=60
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/gtf_to_bed.log"
    shell:
        "(gtfToGenePred -genePredExt {input} {output}.genepred && "
        "genePredToBed {output}.genepred {output}) &> {log}"

rule rseqc_bam_stat:
    input:
        OUT + "/hisat2/{sample}.sorted.bam"
    output:
        OUT + "/rseqc/{sample}.bam_stat.txt"
    resources:
        mem_mb=4000,
        runtime=120
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/rseqc_bam_stat/{sample}.log"
    shell:
        "bam_stat.py -i {input} > {output} 2> {log}"

rule rseqc_infer_experiment:
    input:
        bam=OUT + "/hisat2/{sample}.sorted.bam",
        bed=OUT + "/reference/genes.bed12"
    output:
        OUT + "/rseqc/{sample}.infer_experiment.txt"
    resources:
        mem_mb=4000,
        runtime=120
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/rseqc_infer_experiment/{sample}.log"
    shell:
        "infer_experiment.py -i {input.bam} -r {input.bed} > {output} 2> {log}"

rule rseqc_read_distribution:
    input:
        bam=OUT + "/hisat2/{sample}.sorted.bam",
        bed=OUT + "/reference/genes.bed12"
    output:
        OUT + "/rseqc/{sample}.read_distribution.txt"
    resources:
        mem_mb=8000,
        runtime=120
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/rseqc_read_distribution/{sample}.log"
    shell:
        "read_distribution.py -i {input.bam} -r {input.bed} > {output} 2> {log}"

rule rseqc_inner_distance:
    input:
        bam=OUT + "/hisat2/{sample}.sorted.bam",
        bed=OUT + "/reference/genes.bed12"
    output:
        OUT + "/rseqc/{sample}.inner_distance_freq.txt"
    params:
        prefix=OUT + "/rseqc/{sample}"
    resources:
        mem_mb=8000,
        runtime=240
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/rseqc_inner_distance/{sample}.log"
    shell:
        "inner_distance.py -i {input.bam} -r {input.bed} -o {params.prefix} &> {log}"

rule bed_subset:
    input:
        OUT + "/reference/genes.bed12"
    output:
        OUT + "/reference/genes.subset.bed12"
    params:
        n=config.get("genebody_genes", 10000)
    shell:
        "shuf -n {params.n} --random-source=<(yes) {input} > {output}"

rule rseqc_genebody_coverage:
    input:
        bam=OUT + "/hisat2/{sample}.sorted.bam",
        bed=OUT + "/reference/genes.subset.bed12"
    output:
        OUT + "/rseqc/{sample}.geneBodyCoverage.txt"
    params:
        prefix=OUT + "/rseqc/{sample}"
    resources:
        mem_mb=8000,
        runtime=240
    conda:
        "envs/rseqc.yaml"
    log:
        "logs/rseqc_genebody/{sample}.log"
    shell:
        "geneBody_coverage.py -i {input.bam} -r {input.bed} -o {params.prefix} &> {log}"

rule multibamsummary:
    input:
        bams=expand(OUT + "/hisat2/{sample}.sorted.bam", sample=SAMPLES)
    output:
        OUT + "/deeptools/readCounts.npz"
    threads: config["threads"]["featurecounts"]
    resources:
        mem_mb=8000,
        runtime=120
    conda:
        "envs/deeptools.yaml"
    log:
        "logs/multibamsummary.log"
    shell:
        "multiBamSummary bins -b {input.bams} -p {threads} -o {output} &> {log}"

rule plot_correlation:
    input:
        OUT + "/deeptools/readCounts.npz"
    output:
        OUT + "/deeptools/correlation_heatmap.png"
    resources:
        mem_mb=4000,
        runtime=60
    conda:
        "envs/deeptools.yaml"
    log:
        "logs/plot_correlation.log"
    shell:
        "plotCorrelation -in {input} -c spearman -p heatmap --plotNumbers "
        "-o {output} &> {log}"

rule plot_pca:
    input:
        OUT + "/deeptools/readCounts.npz"
    output:
        OUT + "/deeptools/pca.png"
    resources:
        mem_mb=4000,
        runtime=60
    conda:
        "envs/deeptools.yaml"
    log:
        "logs/plot_pca.log"
    shell:
        "plotPCA -in {input} -o {output} &> {log}"

rule multiqc:
    input:
        expand(OUT + "/fastqc_raw/{sample}_R{r}_fastqc.zip", sample=SAMPLES, r=[1, 2]),
        expand(OUT + "/fastqc_trimmed/{sample}_R{r}_fastqc.zip", sample=SAMPLES, r=[1, 2]),
        expand(OUT + "/fastp/{sample}.json", sample=SAMPLES),
        expand("logs/hisat2/{sample}.log", sample=SAMPLES),
        OUT + "/featurecounts/counts.txt.summary",
        expand(OUT + "/kallisto/{sample}/run_info.json", sample=SAMPLES),
        expand(OUT + "/rseqc/{sample}.bam_stat.txt", sample=SAMPLES),
        expand(OUT + "/rseqc/{sample}.infer_experiment.txt", sample=SAMPLES),
        expand(OUT + "/rseqc/{sample}.read_distribution.txt", sample=SAMPLES),
        expand(OUT + "/rseqc/{sample}.inner_distance_freq.txt", sample=SAMPLES),
        expand(OUT + "/rseqc/{sample}.geneBodyCoverage.txt", sample=SAMPLES),
    output:
        OUT + "/multiqc/multiqc_report.html"
    params:
        outdir=OUT + "/multiqc"
    resources:
        mem_mb=4000,
        runtime=60
    conda:
        "envs/multiqc.yaml"
    log:
        "logs/multiqc.log"
    shell:
        "multiqc -f -o {params.outdir} {OUT} logs/hisat2 &> {log}"
